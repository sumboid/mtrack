{
  "tasks": {
    "dev": "deno run --allow-all npm:vite",
    "build": "deno run --allow-all npm:vite build",
    "lint": "deno run --allow-all npm:eslint .",
    "preview": "deno run --allow-all npm:vite preview"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx"
  },
  "imports": {
    "@emotion/react": "npm:@emotion/react@^11.14.0",
    "@emotion/styled": "npm:@emotion/styled@^11.14.1",
    "@eslint/js": "npm:@eslint/js@^9.39.2",
    "@mui/icons-material": "npm:@mui/icons-material@^7.3.6",
    "@mui/material": "npm:@mui/material@^7.3.6",
    "@mui/x-date-pickers": "npm:@mui/x-date-pickers@^8.23.0",
    "@types/react": "npm:@types/react@^19.2.7",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.2",
    "@xstate/react": "npm:@xstate/react@^6.0.0",
    "dayjs": "npm:dayjs@^1.11.19",
    "dexie": "npm:dexie@^4.2.1",
    "eslint": "npm:eslint@^9.39.2",
    "eslint-plugin-react-hooks": "npm:eslint-plugin-react-hooks@^6.1.1",
    "eslint-plugin-react-refresh": "npm:eslint-plugin-react-refresh@^0.4.26",
    "globals": "npm:globals@^16.5.0",
    "i18next": "npm:i18next@^25.7.3",
    "i18next-browser-languagedetector": "npm:i18next-browser-languagedetector@^8.2.0",
    "nanoid": "npm:nanoid@^5.1.6",
    "react": "npm:react@^19.2.3",
    "react-dom": "npm:react-dom@^19.2.3",
    "react-i18next": "npm:react-i18next@^16.5.0",
    "react-router-dom": "npm:react-router-dom@^7.11.0",
    "rolldown-vite": "npm:rolldown-vite@^7.3.0",
    "typescript": "npm:typescript@^5.9.3",
    "typescript-eslint": "npm:typescript-eslint@^8.51.0",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@^0.20.5",
    "workbox-window": "npm:workbox-window@^7.4.0",
    "xstate": "npm:xstate@^5.25.0",
    "zod": "npm:zod@^4.2.1"
  }
}
